{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.daqem.jobsplus.fabric.JobsPlusFabric"
    ],
    "client": [
      "com.daqem.jobsplus.fabric.client.JobsPlusFabricClient"
    ]
  },
  "mixins": [
    "jobsplus-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_version}",
    "yamlconfig": ">=${config_library_version}",
    "arc": ">=${arc_version}",
    "itemrestrictions": ">=${item_restrictions_version}",
    "uilib": ">=${ui_library_version}",
    "advancednetherite": "*"
  }
}
