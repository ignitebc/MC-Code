##############################################################################
#
#   Gradle이 만든 POSIX용 Gradle 시작 스크립트.
#
##############################################################################

# APP_HOME 설정 시도
# 링크 해석: $0이 링크일 수 있다
app_path=$0
while
    APP_HOME=${app_path%"${app_path##*/}"}  # 끝에 / 가 남는다. 앞쪽 경로가 없으면 빈 값
    [ -h "$app_path" ]
do
    ls=$( ls -ld -- "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit

# 가능한 최댓값을 쓰거나, MAX_FD != -1 로 지정한 값을 쓴다.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# 운영체제별 처리('true' 또는 'false'만 가능).
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true   ;; #(
  NonStop* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# JVM을 시작할 자바 명령을 정한다.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# 가능하면 최대 파일 디스크립터 수를 늘린다.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
      ;;
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
      ;;
    esac
fi

# java 명령에 넘길 인자를 모두 모은다. 참고: https://issues.gradle.org/browse/GRADLE-2310
# 보통은 쓰지 않는다
# shellcheck disable=SC2034
APP_ARGS=$( save () { for i do printf %s\\n "$i" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/' \\\\/" ; done ; printf %s\\n " " ; } ; save "$@" )

# java 명령에 넘길 인자를 모두 모은다.
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, $GRADLE_OPTS에는 따옴표와 변수 치환이 든
#     셸 코드 조각이 들어 있을 수 있으므로, 다시 펼쳐지도록
#     한 번만 펼쳐지도록 임시 변수에 담는다.
#   * 사용자 옵션은 앞선 옵션을 덮어쓸 수 있도록 마지막에 둔다
#     (Android Studio나 Gradle용).
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# "xargs"가 없으면 멈춘다.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# 따옴표로 묶인 인자는 "xargs"로 해석한다.
#
# 참고: https://github.com/gradle/gradle/pull/23103
#
# -n1을 주면 출력이 안정성과 효율 사이에서
# 균형을 이룬다.
eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-+:=/[:alnum:]]~\\&~g; ' |
        tr '\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"
