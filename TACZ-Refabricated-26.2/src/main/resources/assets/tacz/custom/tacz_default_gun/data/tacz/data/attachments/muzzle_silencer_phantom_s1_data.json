{
  "weight": 0.25,
  "ads": {
    // 가산값(여러 부착물의 수치를 더하며 첫 번째 곱셈 단계가 된다)
    "addend": 0.02
  },
  "inaccuracy": {
    "multiplier": 1.1
  },
  "effective_range": {
    "multiplier": 1.5
  },
  "rpm": {
    "multiplier":0.95
  },
  "silence": {
    // 소리가 퍼지는 범위. 기본이 50칸일 때 여기에 -10을 넣으면 소음 후 퍼지는 거리는 40칸이다
    "distance_addend": -20,
    // 소음 전용 음원을 쓸지 여부
    "use_silence_sound": true
  }
}