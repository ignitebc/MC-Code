{
  "slot": "tacz:attachment/slot/sight_exp3",
  // 부착물의 기본 모델. 비울 수 없다
  "model": "tacz:attachment/sight_exp3_geo",
  // 부착물 기본 모델이 쓰는 텍스처. 비울 수 없다
  "texture": "tacz:attachment/uv/sight_exp3",
  "lod": {
    "model": "tacz:attachment/lod/sight_exp3",
    "texture": "tacz:attachment/lod/sight_exp3"
  },
  "zoom": [
    2
  ],
  // 부착물이 조준경이고 원통형 확대 조준경이면 이 옵션은 true여야 한다
  "scope": false,
  // 부착물이 조준경이고 도트나 홀로그램 조준경이면 이 옵션은 true여야 한다
  "sight": true,
  // 조준경 부착물만 이 속성을 설정하며, 조준했을 때 총몸과 조준경을 그리는 fov를 뜻한다.
  // 기본으로 mc가 손 모델을 그리는 fov는 70이다.
  "fov": 35.0,
  "sounds": {
    "install": "tacz:attachments/scope_general_c",
    "uninstall": "tacz:attachments/scope_general_c"
  }
}