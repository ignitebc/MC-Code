{
  "weight": 1.55,
  "ads": {
    // 가산값(여러 부착물의 수치를 더하며 첫 번째 곱셈 단계가 된다)
    "addend": 0.09
  },
  "inaccuracy": {
    "multiplier": 1.1
  },
