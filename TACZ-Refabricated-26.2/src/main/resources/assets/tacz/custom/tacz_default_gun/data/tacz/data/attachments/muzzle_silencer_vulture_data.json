      "multiplier": 0.66
    },
    "yaw": {
      "multiplier": 0.75
    }
  },
  "silence": {
    // 소리가 퍼지는 범위. 기본이 50칸일 때 여기에 -10을 넣으면 소음 후 퍼지는 거리는 40칸이다
    "distance_addend": -25,
    // 소음 전용 음원을 쓸지 여부
    "use_silence_sound": true
  }
