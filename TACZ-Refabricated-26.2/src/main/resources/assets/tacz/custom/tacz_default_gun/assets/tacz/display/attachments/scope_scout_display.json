{
  "slot": "tacz:attachment/slot/scope_scout_slot",
  // 부착물의 기본 모델. 비울 수 없다
  "model": "tacz:attachment/scope_scout_geo",
  // 부착물 기본 모델이 쓰는 텍스처. 비울 수 없다
  "texture": "tacz:attachment/uv/scope_scout",
  // 조준경 부착물만 이 속성을 설정하며, 조준경의 확대 배율을 뜻한다.
  // 플레이어는 배열에 설정한 몇 가지 배율 사이를 바꿀 수 있다
  "lod": {
    "model": "tacz:attachment/lod/scope_scout",
    "texture": "tacz:attachment/lod/scope_scout"
  },
  "zoom": [
    10
  ],
  "views": [
    2
  ],
  "views_fov": [
    25.0
  ],
  // 부착물이 조준경이고 원통형 확대 조준경이면 이 옵션은 true여야 한다
  "scope": true,
  // 부착물이 조준경이고 도트나 홀로그램 조준경이면 이 옵션은 true여야 한다
  "sight": false,
  // 조준경 부착물만 이 속성을 설정하며, 조준했을 때 총몸과 조준경을 그리는 fov를 뜻한다.
  // 기본으로 mc가 손 모델을 그리는 fov는 70이다.
  "sounds": {
    "install": "tacz:attachments/scope_general_c",
    "uninstall": "tacz:attachments/scope_general_c"
  }
}