      "multiplier": 0.8
    },
    "yaw": {
      "multiplier": 0.8
    }
  },
  "effective_range": {
    "addend": 5
  },
  "silence": {
    // 소리가 퍼지는 범위. 기본이 50칸일 때 여기에 -10을 넣으면 소음 후 퍼지는 거리는 40칸이다
    "distance_addend": -12,
    // 소음 전용 음원을 쓸지 여부
    "use_silence_sound": true
  }
