{
  // 기본 모델. 팩 디렉터리의 models 폴더에서 찾으며 비울 수 없다
  "model": "tacz:gun/minigun_geo",
  // 기본 텍스처. 비울 수 없다
  "texture": "tacz:gun/uv/minigun",
  // 저해상도 모델
  "lod": {
    "model": "tacz:gun/lod/minigun",
    "texture": "tacz:gun/lod/minigun"
  },
  // GUI/HUD 화면의 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비워도 된다. 비우면 해당 위치를 그리지 않는다
  "hud": "tacz:gun/hud/minigun",
  // GUI/HUD 화면의 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비워도 된다
  // 비우면 해당 위치는 위 hud + 코드로 빨갛게 칠한 것으로 그린다
  // "hud_empty": "tacz:gun/hud/ak47_empty",
  // 인벤토리/단축바 같은 보관함 칸에 표시하는 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비우지 않는 것을 권한다
  "slot": "tacz:gun/slot/minigun",
  // 탄약 표시 방식. 고를 수 있는 값: "normal"(실제 값 표시), "percent"(백분율 표시). 기본은 "normal"
  "ammo_count_style": "normal",
  // tooltip 피해 표시 방식. 고를 수 있는 값: "total"(총피해), "per_projectile"(산탄 한 발 피해 x 산탄 수). 기본은 "per_projectile"
  "damage_style": "per_projectile",
  // 호출할 애니메이션 이름. 팩 디렉터리의 animations 폴더에서 찾으며 비우지 않는 것을 권한다
  "animation": "tacz:minigun",
  // 상태 기계 스크립트. assets/{네임스페이스}/scripts에 있다
  "state_machine": "tacz:minigun_state_machine",
  // 쓸 기본 애니메이션을 지정한다. 비워도 된다. 위에서 지정한 애니메이션 파일에 draw 같은 애니메이션이 없으면 기본 애니메이션에서 복사한다.
  // 값은 rifle, pistol 중 하나
  "use_default_animation": "rifle",
  // 3인칭 애니메이션. 하드코딩되어 있어 기존 종류만 고를 수 있으며 기본은 default뿐이다
  "third_person_animation": "minigun",
  // 3인칭 애니메이션에서 팔 위치를 고정한다. 기본 false
  // 조준점 표시. 기본으로 조준하면 조준점을 숨기는데, true로 두면 숨기지 않는다
  "show_crosshair": true,
  // 각 시점의 모델 변환 매개변수 조정. 비워도 된다
  "transform": {
    // 지금은 크기만 여기서 지정하고, 회전과 이동은 모델 안의 위치 그룹을 쓴다.
    // 비워도 된다. 비우면 모델 크기를 바꾸지 않는다.
    "scale": {
      // 3인칭 손
      "thirdperson": [0.6, 0.6, 0.6],
      // 땅 위 엔티티
      "ground": [0.6, 0.6, 0.6],
      // 아이템 액자
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 1.5
  },
  // 가늠쇠 조준 확대 배율. 기본 1.2
  "iron_zoom": 2,
  // 탄피 배출 렌더링 데이터. 비워도 되며, 비우면 총이 탄피를 배출하지 않는다
  "zoom_model_fov": 55,
  // 탄피 배출 렌더링 데이터. 비워도 되며, 비우면 총이 탄피를 배출하지 않는다
  "shell": {
    // 탄피 배출 초기 속도
    "initial_velocity": [9, 2, 1],
    // 탄피 배출 무작위 변화 속도
    "random_velocity": [2, 1, 3],
    // 탄피 배출 가속도
    "acceleration": [0.0, -10, 0.0],
    // 탄피 배출 세 축 각속도
    "angular_velocity": [360, -1200, 90],
    // 탄피 렌더링 유지 시간(초)
    "living_time": 1.5
  },
  // 탄환 관련 렌더링 매개변수. ammo display에도 있지만 여기 매개변수가 덮어쓴다
  "ammo": {
    // 예광탄 색. 없으면 #FFFFFF이며, 이 필드가 없으면 ammo의 해당 필드를 쓴다
    // RGB 색 코드를 엄격히 따른다
    "tracer_color": "#FF8888"
    // 입자 효과. 일부 매개변수는 바닐라 명령어와 완전히 같다. 자세한 내용은 wiki 참고: https://minecraft.fandom.com/zh/wiki/%E5%91%BD%E4%BB%A4/particle
    // 이 필드가 없으면 ammo의 해당 필드를 쓴다
    //    "particle": {
    //      // 이름. 고를 수 있는 입자는 wiki 참고: https://minecraft.fandom.com/zh/wiki/%E7%B2%92%E5%AD%90
    //      "name": "campfire_signal_smoke",
    //      // 생성 영역. 기본값은 0 0 0
    //      "delta": [
    //        0,
    //        0,
    //        0
    //      ],
    //      // 속도. 기본값은 0이며 최소 0이어야 한다
    //      "speed": 0,
    //      // 입자 지속 시간(tick). 기본값은 20 tick
    //      "life_time": 50,
    //      // 입자 수. 탄환이 너무 빠르면 이 수를 늘려 탄환 경로의 빈틈을 채울 수 있다
    //      "count": 5
    //    }
  },
  // 총기 효과음. 팩 디렉터리의 sounds 폴더에서 찾으며 비우지 않는 것을 권한다
  "sounds": {
    "shoot": "tacz:minigun/minigun_shoot",
    "shoot_3p": "tacz:minigun/minigun_shoot_3p",
    "put_away": "tacz:minigun/minigun_put_away",
    // 아래 효과음 네 개는 쓰지 않아도 되며, 모드가 기본 효과음을 자동으로 넣는다
    "dry_fire": "tacz:dry_fire",
    "fire_select": "tacz:fire_select",
    "head_hit": "tacz:head_hit",
    "flesh_hit": "tacz:flesh_hit",
    "kill": "tacz:kill",
    // 근접 효과음. 기본으로 넣는다
    "melee_bayonet": "tacz:melee_bayonet/melee_bayonet_01",
    "melee_push": "tacz:melee_stock/melee_stock_01",
    "melee_stock": "tacz:melee_stock/melee_stock_02"
  },
  // 보조 손 총기 표시
  "offhand_show": {
    "pos": [-2, 15, 7],
    "rotate": [-20, -15, 30],
    "scale": [0.5, 0.5, 0.5]
  },
  "hotbar_show": {
    "0": {
      "pos": [-4, 24, 4],
      "rotate": [-90, -5, -90],
      "scale": [0.5, 0.5, 0.5]
    }
  },
  // 총기 모델 위 글자 표시
  "text_show": {
    // 적용할 그룹 이름. 그 그룹의 회전 중심이 글자의 위치와 방향을 정한다
    "ammo_count_text_show_pos": {
      // 글자 크기. 기본 크기는 BlockBench의 1에 해당한다
      "scale": 1,
      // 정렬 방식: right, center, left
      "align": "center",
      // 그림자
      "shadow": false,
      // 글자 색
      "color": "#FFFFFF",
      // 밝기: 1-15
      "light": 15,
      // 현지화되며 PlaceholderAPI 형식의 자리 표시자를 지원한다
      // 지금은 두 가지만 지원한다: %player_name% %ammo_count%
      "text": "text_show.tacz.ak47.ammo_count"
    }
  }
}
