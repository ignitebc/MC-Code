  // 점사 데이터. 점사일 때만 호출한다
  "burst_data": {
    // 연속 사격 여부
    "continuous_shoot": true,
    // 점사 수
    "count": 3,
    // 묶음 안 점사의 연사 속도
    "bpm": 900,
    // 점사 묶음 사이 시간 간격(이전 묶음이 끝난 때부터 다음 묶음이 시작할 때까지)(초)
    "min_interval": 0.3
  },
  "crawl_recoil_multiplier": 0.5,
  // 반동
  "recoil": {
    "pitch": [
      {"time": 0, "value": [0.858, 0.858]},
      {"time": 0.1, "value": [0.858, 0.858]},
      {"time": 0.45, "value": [-0.2275, -0.2275]},
      {"time": 0.6, "value": [0, 0]}
    ],
    "yaw": [
      {"time": 0, "value": [-0.299, 0.234]},
      {"time": 0.35, "value": [0, 0]}
    ]
  },
  // 피격 흔들림 크기 수정 배수. 1은 바닐라 흔들림 정도, 0은 전혀 흔들리지 않음이며 기본값은 0.05
  "hurt_bob_tweak_multiplier": 0.05,
