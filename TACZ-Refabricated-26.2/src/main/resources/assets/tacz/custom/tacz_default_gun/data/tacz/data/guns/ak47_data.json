{
  // 총기 탄약 지정
  "ammo": "tacz:762x39",
  // 탄창 용량
  "ammo_amount": 30,
  // 확장 탄창 탄약 총수
  "extended_mag_ammo_amount": [
    34,
    37,
    40
  ],
  // 논리 기계와 관련 수치 변경 지정
  "script": "tacz:xmag_reload_logic",
  "script_param": {
    "reload_feed": 1.55,
    "reload_cooldown": 2.0,
    "empty_feed": 2.25,
    "empty_cooldown": 2.6,
    "reload_xmag_1_feed": 1.54,
    "reload_xmag_1_cooldown": 2.29,
    "empty_xmag_1_feed": 2.5,
    "empty_xmag_1_cooldown": 2.85,
    "reload_xmag_2_feed": 1.54,
    "reload_xmag_2_cooldown": 2.29,
    "empty_xmag_2_feed": 2.5,
    "empty_xmag_2_cooldown": 2.85,
    "reload_xmag_3_feed": 1.54,
    "reload_xmag_3_cooldown": 2.29,
    "empty_xmag_3_feed": 2.5,
    "empty_xmag_3_cooldown": 2.85
  },
  // 엎드리기 허용 여부
  "can_crawl": true,
  // 비스듬히 쥐기 허용 여부(보기 효과만)
  "can_slide": true,
  // 노리쇠 종류: 개방 노리쇠 대기(open_bolt), 폐쇄 노리쇠 대기(closed_bolt), 수동 장전(manual_action)
  "bolt": "closed_bolt",
  // 분당 발사 탄약 수. 최대 1200을 넘지 않아야 한다
  "rpm": 600,
  // 탄환 엔티티 속성
  "bullet": {
    // 수명(초)
    "life": 0.8,
    // 산탄용. 기본값은 1이며 한 발 피해는 / bullet_amount, 사격할 때마다 탄환 한 발을 차감한다
    "bullet_amount": 1,
    // 피해
    "damage": 2.7,
    // 예광탄 간격 수. 이 필드가 없으면 예광탄을 쏘지 않는다
    // 0으로 두면 모든 탄이 예광탄이다
    "tracer_count_interval": 0,
    // 추가 피해 내용. 비우면 추가 피해 계산 내용이 없다는 뜻이다
    "extra_damage": {
      // 방어 관통률. 기본값은 0으로, 곧 관통 피해가 없다
      "armor_ignore": 0.25,
      // 헤드샷 피해 x1.5
      "head_shot_multiplier": 1.5,
      // 거리-피해 구간 상수 함수
      "damage_adjust": [
        {"distance": 30, "damage": 2.7},
        {"distance": 60, "damage": 2.25},
        // 이 무한대를 빠뜨리면 위 거리를 넘은 경우 0으로 본다
        {"distance": "infinite", "damage": 1.8}
      ]
    },
    // 속도 m/s
    "speed": 250,
    // 중력
    "gravity": 0.15,
    // 넉백 효과
    "knockback": 0,
    // 저항
    "friction": 0.02,
    // 대상 점화
    // "ignite": false,
    "ignite": {
      // 엔티티 점화
      "entity": false,
      // 블록 점화
      "block": false
    },
    // 점화 시간. 기본값은 2초이며 엔티티에만 쓴다
    "ignite_entity_time": 2,
    // 관통 수
    "pierce": 1
    // 폭발 관련 데이터 저장. 없으면 기본 설정 한 벌을 쓴다
    // "explosion": {
      // 폭발 여부. 기본값은 false이며, 기본으로 폭발하게 하려면 true로 둔다
      // "explode": false,
