    "sneak": 2,
    // 엎드려 사격 탄 퍼짐
    "lie": 1.2,
    // 조준 사격 탄 퍼짐
    "aim": 0.265,
    // 질주 직후 사격 탄 퍼짐
    "run": 8.5,
    // 비행 사격 탄 퍼짐
    "fly": 17
  },
  // 근접 관련
  "melee": {
    // 총기 거리 매개변수. 근접 공격 범위를 늘리는 데 쓴다
    // 총검 같은 부착물의 거리와 더한다
    "distance": 1,
    // 사용 후 대기 시간
    // 총검 같은 부착물의 대기 시간과 더한다
    "cooldown": 0.7,
    // 기본 근접 데이터. 부착물 데이터로 바뀐다
    "default": {
      // 애니메이션 종류: 개머리판이 없으면 melee_push, 있으면 melee_stock
      "animation_type": "melee_push",
      // 총검 거리 매개변수. 총기에도 총검 공격 거리 매개변수가 있으며 둘을 더한다
      "distance": 1,
      // 총검 범위 각도
      "range_angle": 40,
      // 총검 대기 시간. 총기에도 총검 대기 시간 매개변수가 있으며 둘을 더한다
      "cooldown": 0,
      // 피해량
      "damage": 0.3,
      // 넉백 효과
      "knockback": 0.5,
