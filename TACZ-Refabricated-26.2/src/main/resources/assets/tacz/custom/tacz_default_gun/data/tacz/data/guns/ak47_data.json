      // 폭발이 블록을 부수는지 여부. 기본값은 false이며, 서버에서도 폭발 블록 파괴를 켜야 쓸 수 있다
      // "destroy_block": false
    // }
  },
  // 사격 소리 전파 거리 보정
  "fire_sound": {
    // 사격 소리 전파 거리 보정 배수
    "fire_multiplier": 1.0,
    // 소음기 사격 소리 전파 거리 보정 배수
    "silence_multiplier": 1.0
  },
  // 재장전 관련
  "reload": {
    // magazine은 탄창 급탄, manual은 수동 급탄, fuel은 연료통 방식 급탄(아이템 하나를 소모해 가득 채움), inventory는 인벤토리 안 탄약을 소모하는 급탄(인벤토리 직접 장전)이다
    "type": "magazine",
    // 무한 예비 탄약. 지금은 이 항목이 "inventory"와 호환되지 않는다는 점에 주의한다
    "infinite": false,
    // 탄창 급탄 재장전 시간(초). 이 시점에 서버가 총 안 탄환 수를 갱신한다
    "feed": {
      // 빈 탄창 재장전
      "empty": 2.25,
      // 전술 재장전
      "tactical": 1.55
    },
    // 탄창 급탄 총시간(초). 이 시점이 되어야 총기가 발사, 점검 등을 할 수 있다.
    "cooldown": {
      // 빈 탄창 재장전
      "empty": 2.6,
      // 전술 재장전
      "tactical": 2.0
    }
  },
