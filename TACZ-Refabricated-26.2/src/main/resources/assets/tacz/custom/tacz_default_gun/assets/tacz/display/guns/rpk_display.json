{
  // 기본 모델. 팩 디렉터리의 models 폴더에서 찾으며 비울 수 없다
  "model": "tacz:gun/rpk_geo",
  // 기본 텍스처. 비울 수 없다
  "texture": "tacz:gun/uv/rpk",
  // 저해상도 모델
  "lod": {
    "model": "tacz:gun/lod/rpk",
    "texture": "tacz:gun/lod/rpk"
  },
  // GUI/HUD 화면의 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비워도 된다. 비우면 해당 위치를 그리지 않는다
  "hud": "tacz:gun/hud/rpk",
  // GUI/HUD 화면의 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비워도 된다
  // 비우면 해당 위치는 위 hud + 코드로 빨갛게 칠한 것으로 그린다
  // "hud_empty": "tacz:gun/hud/rpk_empty",
  // 인벤토리/단축바 같은 보관함 칸에 표시하는 2D 텍스처. 팩 디렉터리의 textures 폴더에서 찾으며 비우지 않는 것을 권한다
  "slot": "tacz:gun/slot/rpk",
  // 호출할 애니메이션 이름. 팩 디렉터리의 animations 폴더에서 찾으며 비우지 않는 것을 권한다
  "animation": "tacz:rpk",
  // 상태 기계 스크립트. assets/{네임스페이스}/scripts에 있다
  "state_machine": "tacz:default_state_machine",
  // 쓸 기본 애니메이션을 지정한다. 비워도 된다. 위에서 지정한 애니메이션 파일에 draw 같은 애니메이션이 없으면 기본 애니메이션에서 복사한다.
  // 값은 rifle, pistol 중 하나
  "use_default_animation": "rifle",
  // 3인칭 애니메이션. 하드코딩되어 있어 기존 종류만 고를 수 있으며 기본은 default뿐이다
  "third_person_animation": "default",
  // 조준점 표시. 기본으로 조준하면 조준점을 숨기는데, true로 두면 숨기지 않는다
  "show_crosshair": false,
  // 각 시점의 모델 변환 매개변수 조정. 비워도 된다
  "transform": {
    // 지금은 크기만 여기서 지정하고, 회전과 이동은 모델 안의 위치 그룹을 쓴다.
    // 비워도 된다. 비우면 모델 크기를 바꾸지 않는다.
    "scale": {
      // 3인칭 손
      "thirdperson": [0.6, 0.6, 0.6],
      // 땅 위 엔티티
      "ground": [0.6, 0.6, 0.6],
      // 아이템 액자
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 0.75
  },
  // 가늠쇠 조준 확대 배율. 기본 1.2
  "iron_zoom": 1.33,
  "zoom_model_fov": 45,
  // 탄피 배출 렌더링 데이터. 비워도 되며, 비우면 총이 탄피를 배출하지 않는다
  "shell": {
    // 탄피 배출 초기 속도
    "initial_velocity": [5, 2, 1],
    // 탄피 배출 무작위 변화 속도
    "random_velocity": [1, 1, 0.25],
    // 탄피 배출 가속도
    "acceleration": [0.0, -10, 0.0],
    // 탄피 배출 세 축 각속도
    "angular_velocity": [360, -1200, 90],
    // 탄피 렌더링 유지 시간(초)
    "living_time": 1.0
  },
  // 총기 효과음. 팩 디렉터리의 sounds 폴더에서 찾으며 비우지 않는 것을 권한다
  "sounds": {
    "shoot": "tacz:rpk/rpk_shoot",
    "shoot_3p": "tacz:rpk/rpk_shoot_3p",
    "reload_empty": "tacz:rpk/rpk_reload_empty",
    "reload_tactical": "tacz:rpk/rpk_reload_tactical",
    "inspect": "tacz:rpk/rpk_inspect",
    "inspect_empty": "tacz:rpk/rpk_inspect_empty",
    "draw": "tacz:rpk/rpk_draw",
    "put_away": "tacz:rpk/rpk_put_away",
    "silence": "tacz:rpk/rpk_silence",
    "silence_3p": "tacz:rpk/rpk_silence_3p",
    // 아래 효과음 네 개는 쓰지 않아도 되며, 모드가 기본 효과음을 자동으로 넣는다
    "dry_fire": "tacz:dry_fire",
    "fire_select": "tacz:fire_select",
    "head_hit": "tacz:head_hit",
    "flesh_hit": "tacz:flesh_hit",
    "kill": "tacz:kill",
    "melee_push": "tacz:melee_stock/melee_stock_02",
    "melee_stock": "tacz:melee_stock/melee_stock_03"
  },
  // 보조 손 총기 표시
  "offhand_show": {
    // 위치. 베드락판 수치 표시와 같다
    // 기본은 [-2, 20, 3.5]
    "pos": [1, 20, 3.5],
    // 회전(도). 기본은 [0, 0, -30]
    "rotate": [0, 0, 60],
    // 크기. 기본은 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 단축바 총기 표시
  // 이 필드가 없으면 단축바 총기를 표시하지 않는다
  "hotbar_show": {
    // 단축바 번호. 기본은 0-8로 아홉 개지만 실제로는 주 손을 빼면 여덟 개만 표시할 수 있다
    // 없는 것은 표시하지 않는다
    "0": {
      "pos": [-1, 20, 3],
      "rotate": [-180, 0, 120],
      "scale": [0.5, 0.5, 0.5]
    }
  },
  // 총기 모델 위 글자 표시
  "text_show": {
    // 적용할 그룹 이름. 그 그룹의 회전 중심이 글자의 위치와 방향을 정한다
    "ammo_count_text_show_pos": {
      // 글자 크기. 기본 크기는 BlockBench의 1에 해당한다
      "scale": 1,
      // 정렬 방식: right, center, left
      "align": "center",
      // 그림자
      "shadow": false,
      // 글자 색
      "color": "#FFFFFF",
      // 밝기: 1-15
      "light": 15,
      // 현지화되며 PlaceholderAPI 형식의 자리 표시자를 지원한다
      // 지금은 두 가지만 지원한다: %player_name% %ammo_count%
      "text": "text_show.tacz.rpk.ammo_count"
    }
  }
}