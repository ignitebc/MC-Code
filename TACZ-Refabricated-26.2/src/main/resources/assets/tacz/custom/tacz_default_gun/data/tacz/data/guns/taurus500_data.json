  "charging": {
    "semi": {
      // 충전 방식
      // auto - 방아쇠를 누르고 있으면 충전하고, 가득 차면 자동 발사
      // hold - 방아쇠를 누르고 있으면 충전하고, 방아쇠를 놓아야 발사(문턱값을 넘었을 때)
      // delay - 방아쇠를 누르면 자동으로 충전하고, 가득 차면 자동 발사하며 취소할 수 없다
      "type": "auto",
      // 방아쇠를 누르고/놓을 때 tick마다 늘고 주는 충전 진행도(음수 아님)
      "increase_per_tick": 0.1,
      "decrease_per_tick": 0.1,
      // 발사 후 깎는 충전 진행도
      // 발사 방식이 자동이고 충전 방식이 auto일 때 초기화하지 않으면 첫 발 충전을 마친 뒤 방아쇠를 누른 채 계속 발사할 수 있다
      // 충전 방식이 hold일 때 발사 후에도 충전 진행도가 문턱값보다 크면 방아쇠를 놓아도 통제할 수 없이 계속 발사한다(문턱값보다 크면 decrease_per_tick이 일어나지 않음)
      // 충전 방식이 delay일 때 이 값은 효과가 없다(항상 0으로 초기화)
      "decrease_on_fire": 0.5,
      // 최대 충전 진행도
      "max_charge": 0.5,
      // 발사 문턱값. 충전 진행도가 최소 이 값에 이르러야 발사할 수 있다(hold 방식에서만 적용)
      "fire_threshold": 0.5,
      // 사격 대기 시간 동안 충전할 수 있는지 여부
      "charge_during_cooldown": false
    }
  },
