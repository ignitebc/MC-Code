{
  // 총기 탄약 지정
  "ammo": "tacz:762x39",
  // 탄창 용량
  "ammo_amount": 40,
  // 확장 탄창 탄약 총수
  "extended_mag_ammo_amount": [
    50,
    60,
    75
  ],
  // 노리쇠 종류: 개방 노리쇠 대기(open_bolt), 폐쇄 노리쇠 대기(closed_bolt), 수동 장전(manual_action)
  "bolt": "closed_bolt",
  // 분당 발사 탄약 수. 최대 1200을 넘지 않아야 한다
  "rpm": 630,
  // 탄환 엔티티 속성
  "bullet": {
    // 수명(초)
    "life": 0.9,
    // 산탄용. 기본값은 1이며 한 발 피해는 / bullet_amount, 사격할 때마다 탄환 한 발을 차감한다
    "bullet_amount": 1,
    // 피해
    "damage": 3,
    // 예광탄 간격 수. 이 필드가 없으면 예광탄을 쏘지 않는다
    // 0으로 두면 모든 탄이 예광탄이다
    "tracer_count_interval": 0,
    // 추가 피해 내용. 비우면 추가 피해 계산 내용이 없다는 뜻이다
    "extra_damage": {
      // 방어 관통률. 기본값은 0으로, 곧 관통 피해가 없다
      "armor_ignore": 0.3,
      // 헤드샷 피해 x1.5
      "head_shot_multiplier": 1.5,
      // 거리-피해 구간 상수 함수
      "damage_adjust": [
        {"distance": 36, "damage": 3},
        {"distance": 64, "damage": 2.1},
        // 이 무한대를 빠뜨리면 위 거리를 넘은 경우 0으로 본다
        {"distance": "infinite", "damage": 1.8}
      ]
    },
    // 속도 m/s
    "speed": 270,
    // 중력
    "gravity": 0.15,
    // 넉백 효과
    "knockback": 0,
    // 저항
    "friction": 0.02,
    // 대상 점화
    "ignite": false,
    // 점화 시간. 기본값은 2초이며 엔티티에만 쓴다
    "ignite_entity_time": 2,
    // 관통 수
    "pierce": 2,
    // 폭발 여부. 이 필드가 없으면 false다
    //"explosion": {
    //  지연 폭발(초)
    //  "delay": 5
    //  "radius": 5,
    //  "damage": 1.5,
    //  폭발 넉백. 기본값은 false이며, 서버에서도 폭발 넉백을 켜야 쓸 수 있다
    //  "knockback": false
    //}
    "explosion": {
      "explode": false,
      "damage": 6.6,
      "radius": 0.6,
      "knockback": true,
      "delay": 1
    }
  },
  // 재장전 관련
  "reload": {
    // magazine은 탄창 급탄, manual은 수동 급탄이다
    "type": "magazine",
    // 탄창 급탄 재장전 시간(초). 이 시점에 서버가 총 안 탄환 수를 갱신한다
    "feed": {
      // 빈 탄창 재장전
      "empty": 2.95,
      // 전술 재장전
      "tactical": 1.95
    },
    // 탄창 급탄 총시간(초). 이 시점이 되어야 총기가 발사, 점검 등을 할 수 있다.
    "cooldown": {
      // 빈 탄창 재장전
      "empty": 3.69,
      // 전술 재장전
      "tactical": 2.77
    }
  },
  // 총을 드는 동작 시간(초).
  // 드는 동작이 끝나면 총기가 발사, 점검 등을 할 수 있다
  "draw_time": 0.67,
  // 총을 집어넣는 동작 시간(초).
  "put_away_time": 0.6,
  // 조준 시간(초).
  "aim_time": 0.17,
  "sprint_time": 0.23,
  // 노리쇠를 당겨 장전하는 시간. 노리쇠 종류가 manual_action일 때만 유효하다
  // "bolt_action_time": 0.9,
  // 발사 방식
  "weight": 4.5,
  "movement_speed": {
    "base": 0.0,
    "aim": -0.2,
    "reload": 0
  },
  "crawl_recoil_multiplier": 0.2,
  "fire_mode": [
    // 자동
    "auto",
    // 반자동
    "semi"
  ],
  "recoil": {
    "pitch": [
      {"time": 0, "value": [0.78, 0.78]},
      {"time": 0.25, "value": [0.78, 0.78]},
      {"time": 0.65, "value": [-0.2275, -0.2275]},
      {"time": 0.7, "value": [0, 0]}
    ],
    "yaw": [
      {"time": 0, "value": [-0.4875, 0.455]},
      {"time": 0.25, "value": [-0.4875, 0.455]},
      {"time": 0.45, "value": [0, 0]}
    ]
  },
  // 피격 흔들림 크기 수정 배수. 1은 바닐라 흔들림 정도, 0은 전혀 흔들리지 않음이며 기본값은 0.05
  "hurt_bob_tweak_multiplier": 0.05,
  // 부정확도
  "inaccuracy": {
    // 서서 사격 탄 퍼짐
    "stand": 3.77,
    // 이동 사격 탄 퍼짐
    "move": 5.4,
    // 웅크려 사격 탄 퍼짐
    "sneak": 2.6,
    // 엎드려 사격 탄 퍼짐
    "lie": 1.6,
    // 조준 사격 탄 퍼짐
    "aim": 0.265,
    // 질주 직후 사격 탄 퍼짐
    "run": 7.71,
    // 비행 사격 탄 퍼짐
    "fly": 15.42
  },
  // 근접 관련
  "melee": {
    // 총기 거리 매개변수. 근접 공격 범위를 늘리는 데 쓴다
    // 총검 같은 부착물의 거리와 더한다
    "distance": 1,
    // 사용 후 대기 시간
    "cooldown": 0.7,
    // 기본 근접 데이터. 부착물 데이터로 바뀐다
    "default": {
      // 애니메이션 종류: 개머리판이 없으면 melee_push, 있으면 melee_stock
      "animation_type": "melee_stock",
      // 총검 거리 매개변수. 총기에도 총검 공격 거리 매개변수가 있으며 둘을 더한다
      "distance": 1,
      // 총검 범위 각도
      "range_angle": 30,
      // 피해량
      "damage": 1.2,
      // 넉백 효과
      "knockback": 0.6,
      // 준비 동작 시간(초)
      "prep": 0.1
    }
  },
  // 열린 부착물 칸. 지정하지 않은 칸은 기본으로 닫힌다. 전체 부착물 칸 종류:
  // scope, stock, muzzle, grip, laser, extended_mag
  "allow_attachment_types": [
    "scope",
    "stock",
    "muzzle",
    "extended_mag"
  ],
  // 전용 부착물 속성
  "exclusive_attachments": {
  }
}