{
  "schemaVersion": 1,
  "id": "arc",
  "version": "${version}",
  "name": "Arc",
  "description": "",
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.daqem.arc.fabric.ArcFabric"
    ],
    "client": [
      "com.daqem.arc.fabric.client.ArcFabricClient"
    ]
  },
  "mixins": [
    "arc.mixins.json",
    "arc-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_version}",
    "uilib": ">=${ui_library_version}",
    "yamlconfig": ">=${config_library_version}"
  }
}
