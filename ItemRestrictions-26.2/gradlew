##############################################################################
#
#   Gradle이 만든 POSIX용 Gradle 시작 스크립트.
#
#   실행할 때 중요한 점:
#
#   (1) 이 스크립트를 실행하려면 POSIX 호환 셸이 필요하다. /bin/sh가
#       호환되지 않고 ksh나 bash 같은 호환 셸이 따로 있다면,
#       명령줄 전체 앞에 그 셸 이름을 붙여 실행한다.
#       예:
#
#           ksh Gradle
#
#       Busybox처럼 기능을 줄인 셸에서는 동작하지 않는다. 이 스크립트는
#       다음 POSIX 셸 기능을 모두 필요로 한다:
#         * 함수
#         * 확장 «$var», «${var}», «${var:-default}», «${var+SET}»,
#           «${var#prefix}», «${var%suffix}», «$( cmd )»
#         * 종료 상태를 검사할 수 있는 복합 명령, 특히 «case»
#         * «command», «set», «ulimit» 등 여러 내장 명령
#
#   수정할 때 중요한 점:
#
#   (2) 이 스크립트는 모든 POSIX 셸을 대상으로 하므로 Bash, Ksh 등의
#       확장 기능, 특히 배열을 쓰지 않는다.
#
#       여러 인자를 공백으로 구분한 문자열 하나에 담는 "전통적인" 방식은
#       버그와 보안 문제의 원인으로 잘 알려져 있으므로 (대부분) 피하고,
#       옵션을 "$@"에 차례로 쌓은 뒤
#       마지막에 자바로 넘긴다.
#
#       물려받은 환경 변수(DEFAULT_JVM_OPTS, JAVA_OPTS,
#       GRADLE_OPTS)가 단어 분리에 의존하는 경우에는 명시적으로 분리한다.
#       자세한 내용은 줄마다 붙은 주석을 참고한다.
#
#       AIX, CygWin, Darwin, MinGW, NonStop 같은 특정 운영체제를 위한
#       조정이 들어 있다.
#
#   (3) 이 스크립트는 Gradle 프로젝트 안의 Groovy 템플릿으로
#       https://github.com/gradle/gradle/blob/master/subprojects/plugins/src/main/resources/org/gradle/api/internal/plugins/unixStartScript.txt
#       만들어진다.
#
#       Gradle은 https://github.com/gradle/gradle/ 에 있다.
#
##############################################################################

# APP_HOME 설정 시도

# 링크 해석: $0이 링크일 수 있다
app_path=$0

# 여러 단계로 이어진 심볼릭 링크에 필요하다.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # 끝에 / 가 남는다. 앞쪽 경로가 없으면 빈 값
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

# 기본 JVM 옵션은 여기에 추가한다. JAVA_OPTS와 GRADLE_OPTS로도 이 스크립트에 JVM 옵션을 넘길 수 있다.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# 가능한 최댓값을 쓰거나, MAX_FD != -1 로 지정한 값을 쓴다.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# 운영체제별 처리('true' 또는 'false'만 가능).
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# JVM을 시작할 자바 명령을 정한다.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # AIX의 IBM JDK는 실행 파일 위치가 특이하다
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# 가능하면 최대 파일 디스크립터 수를 늘린다.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# java 명령에 넘길 인자를 모두 모은다. 다음 순서의 역순으로 쌓는다:
#   * 명령줄 인자
#   * 메인 클래스 이름
#   * -classpath
#   * -D...appname 설정
#   * --module-path (필요할 때만)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, GRADLE_OPTS 환경 변수

# Cygwin이나 MSYS에서는 java 실행 전에 경로를 Windows 형식으로 바꾼다
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # 이제 인자를 변환한다 - /bin/sh 범위 안에서 처리하기 위한 임시방편
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # 옵션은 건드리지 않는다 #(
              /?*)  t=${arg#/} t=/${t%%/*}              # POSIX 파일 경로로 보임
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" )
        fi
        # 인자 수만큼 정확히 인자 목록을 돌려서, 각 인자가 바뀌었을 수는 있어도
        # 원래 자리로
        # 돌아오게 한다.
        #
        # 참고: `for` 반복은 시작 전에 반복 목록을 잡아 두므로,
        # 여기서 위치 매개변수를 바꿔도 반복 횟수나
        # `arg`에 들어오는 값은 바뀌지 않는다.
        shift                   # 예전 인자 제거
        set -- "$@" "$arg"      # 바꾼 인자 넣기
    done
fi

# java 명령에 넘길 인자를 모두 모은다.
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, $GRADLE_OPTS에는 따옴표와 변수 치환이 든
#     셸 코드 조각이 들어 있을 수 있으므로, 다시 펼쳐지도록
#     큰따옴표로 감싼다.
#   * 나머지는 다시 펼쳐지지 않도록 작은따옴표로 감싼다.

set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# 따옴표로 묶인 인자는 "xargs"로 해석한다.
#
# -n1을 주면 따옴표와 역슬래시를 뺀 인자를 한 줄에 하나씩 출력한다.
#
# Bash라면 간단히 다음과 같이 쓸 수 있다:
#
#   readarray ARGS < <( xargs -n1 <<<"$var" ) &&
#   set -- "${ARGS[@]}" "$@"
#
# 하지만 POSIX 셸에는 배열도 명령 치환도 없으므로, 각 인자를
# (sed 입력 한 줄로) 후처리해 셸 메타 문자가 될 수 있는 글자를 역슬래시로
# 이스케이프한 뒤, eval로 그 과정을 되돌리고(인자 구분은 유지),
# 전체를 "set" 문장 하나로
# 감싼다.
#
# 물론 이 변수들에 줄바꿈이나 짝이 맞지 않는 따옴표가 있으면
# 동작하지 않는다.
#

eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-[:alnum:]+,./:=@_]~\\&~g; ' |
        tr '\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"
